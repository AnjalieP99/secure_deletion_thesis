while true; do
    current=$(df -h /mnt/ssd_test | tail -1 | awk '{print $5}' | sed 's/%//')
    echo "Current usage: ${current}%"
    
    if [ $current -ge 25 ]; then
        echo "✅ Reached 25% fill!"
        break
    fi
    
    make_filler $count
    count=$((count + 1))
    
    if [ $((count % 10)) -eq 0 ]; then
        echo "Created $count filler datasets"
        df -h /mnt/ssd_test
    fi
done
