search_live_drive() {
    local time_label="$1"

    local output_dir="$HOME/search_results/trim_on_25"
    local output_file="$output_dir/search_${time_label}.txt"
    local strings_file="$output_dir/strings_${time_label}.txt"

    # Create output directory
    mkdir -p "$output_dir"

    echo "========================================" | tee "$output_file"
    echo "SSD RAW DATA SEARCH" | tee -a "$output_file"
    echo "========================================" | tee -a "$output_file"
    echo "Time label: ${time_label}" | tee -a "$output_file"
    echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S %Z')" | tee -a "$output_file"
    echo "Device: /dev/sda" | tee -a "$output_file"
    echo "Device model: EDILOCA ES106 128GB" | tee -a "$output_file"
    echo "========================================" | tee -a "$output_file"
    echo "" | tee -a "$output_file"

    # --------------------------------------------------
    # ONE RAW READ OF THE ENTIRE SSD
    # --------------------------------------------------

    echo "Reading /dev/sda once and extracting printable strings..." | tee -a "$output_file"
    echo "This may take several minutes." | tee -a "$output_file"
    echo "" | tee -a "$output_file"

    sudo strings -a /dev/sda > "$strings_file"

    if [ $? -ne 0 ]; then
        echo "ERROR: Raw device read failed." | tee -a "$output_file"
        return 1
    fi

    echo "Raw read completed." | tee -a "$output_file"
    echo "Strings saved to: $strings_file" | tee -a "$output_file"
    echo "" | tee -a "$output_file"

    # --------------------------------------------------
    # TEST DATA SIGNATURES
    # --------------------------------------------------

    echo "========================================" | tee -a "$output_file"
    echo "TEST DATA SIGNATURES" | tee -a "$output_file"
    echo "========================================" | tee -a "$output_file"

    for i in {1..3}; do
        signature="UNIQUE_SIGNATURE_TEST_${i}"

        count=$(grep -Fc "$signature" "$strings_file")

        echo "${signature}: ${count} occurrence(s)" | tee -a "$output_file"
    done

    echo "" | tee -a "$output_file"

    # --------------------------------------------------
    # FILLER DATA CONTROL
    # --------------------------------------------------

    echo "========================================" | tee -a "$output_file"
    echo "FILLER DATA SIGNATURES (CONTROL)" | tee -a "$output_file"
    echo "========================================" | tee -a "$output_file"

    filler_count=$(grep -Fc "FILLER_SIGNATURE" "$strings_file")

    echo "FILLER_SIGNATURE: ${filler_count} occurrence(s)" | tee -a "$output_file"

[7m    echo "" | tee -a "$output_file"[27m

